# Generate distinct random values for production. Never commit the populated .env.local.
OTP_HMAC_SECRET=
SESSION_HMAC_SECRET=

# Upstash Redis REST credentials. Used for expiring OTPs, rate limits, and one-use download grants.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend: use a sender address on a verified domain.
RESEND_API_KEY=
OTP_FROM_EMAIL=

# Twilio Programmable Messaging credentials. Configure a sender approved for your destination country.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional voluntary UPI support. QR amount is fixed to INR 25 and never gates downloads.
SUPPORT_UPI_ID=
SUPPORT_PAYEE_NAME=ATS-Craft Pro
